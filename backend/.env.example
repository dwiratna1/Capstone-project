NODE_ENV=development
PORT=5000

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/modalin?schema=public"

# Frontend origin allowed by CORS. Use comma-separated values for multiple origins.
CORS_ORIGIN=http://localhost:5173

# Authentication.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=7d

# Future FastAPI AI service integration.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000
